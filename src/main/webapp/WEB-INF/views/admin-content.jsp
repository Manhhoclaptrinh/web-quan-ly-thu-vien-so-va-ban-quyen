<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Admin - Nội dung</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/admin.css"></head>
<body class="admin-body"><div class="admin-shell"><%@ include file="/WEB-INF/views/admin-nav.jsp" %><main class="admin-main">
<header class="admin-head"><div><div class="eyebrow">CONTENT MANAGEMENT</div><h1>Nội dung</h1><p>Quản lý tài liệu, sách và video trực tiếp từ Admin Panel.</p></div><div class="actions"><a class="btn primary" href="${pageContext.request.contextPath}/admin/content/form?type=DOCUMENT">＋ Tài liệu</a><a class="btn primary" href="${pageContext.request.contextPath}/admin/content/form?type=BOOK">＋ Sách</a><a class="btn primary" href="${pageContext.request.contextPath}/admin/content/form?type=VIDEO">＋ Video</a></div></header>
<div class="tabs"><button class="tab active" onclick="showTab('documents',this)">📄 Tài liệu (${documents.size()})</button><button class="tab" onclick="showTab('books',this)">📚 Sách (${books.size()})</button><button class="tab" onclick="showTab('videos',this)">🎬 Video (${videos.size()})</button></div>
<section id="documents" class="content-tab panel"><div class="toolbar"><input class="table-filter" placeholder="🔎 Tìm tài liệu..."><select class="status-select"><option value="">Tất cả trạng thái</option><option>AVAILABLE</option><option>DISABLED</option></select></div><table class="table filterable"><thead><tr><th>ID</th><th>Nội dung</th><th>Danh mục</th><th>Access</th><th>Status</th><th>Upload</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="d" items="${documents}"><tr><td>#${d.documentId}</td><td><b>${d.title}</b><small>${d.author}</small></td><td>${d.categoryName}</td><td><span class="badge">${d.accessLevel}</span></td><td><span class="status ${d.status=='AVAILABLE'?'ok':'danger'}">${d.status}</span></td><td>${d.uploaderName}</td><td class="row-actions"><a class="btn sm" href="${pageContext.request.contextPath}/admin/content/form?type=DOCUMENT&id=${d.documentId}">Sửa</a><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="action" value="content-toggle"><input type="hidden" name="type" value="DOCUMENT"><input type="hidden" name="id" value="${d.documentId}"><input type="hidden" name="status" value="${d.status=='AVAILABLE'?'DISABLED':'AVAILABLE'}"><button class="btn sm">${d.status=='AVAILABLE'?'Ẩn':'Hiện'}</button></form><form method="post" action="${pageContext.request.contextPath}/admin" onsubmit="return confirm('Xóa nội dung này?')"><input type="hidden" name="action" value="content-delete"><input type="hidden" name="type" value="DOCUMENT"><input type="hidden" name="id" value="${d.documentId}"><button class="btn sm danger-btn">Xóa</button></form></td></tr></c:forEach></tbody></table></section>
<section id="books" class="content-tab panel hidden"><div class="toolbar"><input class="table-filter" placeholder="🔎 Tìm sách..."><select class="status-select"><option value="">Tất cả trạng thái</option><option>AVAILABLE</option><option>DISABLED</option></select></div><table class="table filterable"><thead><tr><th>ID</th><th>Sách</th><th>ISBN / NXB</th><th>Access</th><th>Status</th><th>Bản sao</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="b" items="${books}"><tr><td>#${b.bookId}</td><td><b>${b.title}</b><small>${b.author}</small></td><td>${b.isbn}<small>${b.publisher}</small></td><td><span class="badge">${b.accessLevel}</span></td><td><span class="status ${b.status=='AVAILABLE'?'ok':'danger'}">${b.status}</span></td><td>${b.availableCopies}/${b.totalCopies}</td><td class="row-actions"><a class="btn sm" href="${pageContext.request.contextPath}/admin/content/form?type=BOOK&id=${b.bookId}">Sửa</a><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="action" value="content-toggle"><input type="hidden" name="type" value="BOOK"><input type="hidden" name="id" value="${b.bookId}"><input type="hidden" name="status" value="${b.status=='AVAILABLE'?'DISABLED':'AVAILABLE'}"><button class="btn sm">${b.status=='AVAILABLE'?'Ẩn':'Hiện'}</button></form><form method="post" action="${pageContext.request.contextPath}/admin" onsubmit="return confirm('Xóa sách này?')"><input type="hidden" name="action" value="content-delete"><input type="hidden" name="type" value="BOOK"><input type="hidden" name="id" value="${b.bookId}"><button class="btn sm danger-btn">Xóa</button></form></td></tr></c:forEach></tbody></table></section>
<section id="videos" class="content-tab panel hidden"><div class="toolbar"><input class="table-filter" placeholder="🔎 Tìm video..."><select class="status-select"><option value="">Tất cả trạng thái</option><option>AVAILABLE</option><option>DISABLED</option></select></div><table class="table filterable"><thead><tr><th>ID</th><th>Video</th><th>Danh mục</th><th>Access</th><th>Status</th><th>Upload</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="v" items="${videos}"><tr><td>#${v.videoId}</td><td><b>${v.title}</b><small>${v.author}</small></td><td>${v.categoryName}</td><td><span class="badge">${v.accessLevel}</span></td><td><span class="status ${v.status=='AVAILABLE'?'ok':'danger'}">${v.status}</span></td><td>${v.uploaderName}</td><td class="row-actions"><a class="btn sm" href="${pageContext.request.contextPath}/admin/content/form?type=VIDEO&id=${v.videoId}">Sửa</a><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="action" value="content-toggle"><input type="hidden" name="type" value="VIDEO"><input type="hidden" name="id" value="${v.videoId}"><input type="hidden" name="status" value="${v.status=='AVAILABLE'?'DISABLED':'AVAILABLE'}"><button class="btn sm">${v.status=='AVAILABLE'?'Ẩn':'Hiện'}</button></form><form method="post" action="${pageContext.request.contextPath}/admin" onsubmit="return confirm('Xóa video này?')"><input type="hidden" name="action" value="content-delete"><input type="hidden" name="type" value="VIDEO"><input type="hidden" name="id" value="${v.videoId}"><button class="btn sm danger-btn">Xóa</button></form></td></tr></c:forEach></tbody></table></section>
<script>function showTab(id,b){document.querySelectorAll('.content-tab').forEach(x=>x.classList.add('hidden'));document.getElementById(id).classList.remove('hidden');document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active')}document.querySelectorAll('.content-tab').forEach(tab=>{const input=tab.querySelector('.table-filter'),sel=tab.querySelector('.status-select');function f(){const q=input.value.toLowerCase();tab.querySelectorAll('tbody tr').forEach(x=>x.style.display=((x.innerText.toLowerCase().includes(q))&&(!sel.value||x.innerText.includes(sel.value)))?'':'none')}input.addEventListener('input',f);sel.addEventListener('change',f)});</script>
</main></div></body></html>
