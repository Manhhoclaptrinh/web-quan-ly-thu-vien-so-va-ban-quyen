<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Quản lý danh mục</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head>
<body><%@ include file="/views/_navbar.jsp" %><div class="container"><div class="card"><div class="flex-between"><div><h1>Quản lý danh mục</h1><p class="text-muted">Tổ chức tài liệu theo nhóm chủ đề.</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/categories/add">+ Thêm danh mục</a></div></div>
<div class="card"><table><thead><tr><th>ID</th><th>Tên danh mục</th><th>Mô tả</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="c" items="${categories}"><tr><td>${c.categoryId}</td><td><strong>${c.categoryName}</strong></td><td>${c.description}</td><td><a href="${pageContext.request.contextPath}/categories/edit?id=${c.categoryId}">Sửa</a> | <a href="${pageContext.request.contextPath}/categories/delete?id=${c.categoryId}" onclick="return confirm('Xóa danh mục? Tài liệu thuộc danh mục sẽ không bị xóa.');" style="color:#dc2626">Xóa</a></td></tr></c:forEach></tbody></table></div></div></body></html>
